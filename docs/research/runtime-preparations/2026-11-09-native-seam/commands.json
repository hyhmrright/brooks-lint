        "node",
        "sha256:c6de6f9c1b1676f52d2a4e53cf707e95b3c80ad903956e8140ebf3a4b801ebf8",
        "-e",
        "const fs=require('fs'),cp=require('child_process'),crypto=require('crypto');const r=cp.spawnSync('codex',['app-server','generate-json-schema','--experimental','--out','/tmp/schema'],{encoding:'utf8',timeout:15000});const files=[];function walk(d){for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=d+'/'+e.name;if(e.isDirectory())walk(p);else if(e.name.endsWith('.json')){const b=fs.readFileSync(p);files.push({path:p.slice(12),sha256:crypto.createHash('sha256').update(b).digest('hex'),bytes:b.length});}}}if(r.status===0)walk('/tmp/schema');const selected=files.filter(x=>/ThreadStartParams|Environment|ExecServer|DynamicTool|SandboxPolicy|CommandExecutionRequest/.test(x.path));console.log(JSON.stringify({generation:{status:r.status,stdout:r.stdout,stderr:r.stderr},file_count:files.length,files,selected:selected.map(x=>({...x,schema:JSON.parse(fs.readFileSync('/tmp/schema/'+x.path))}))},null,2));"
      ],
