/** Owned HTTP fixtures; no external endpoints or real credentials. */
import http from 'node:http';
import {createHash} from 'node:crypto';
import {runControlledFixture} from './controlled-read-adapter.mjs';
const hash=s=>createHash('sha256').update(s).digest('hex');
const key='fixture-only-'+'1'.repeat(32);
const packet=()=>({files:[{path:'case/code.js',content:'SYNTHETIC code',sha256:hash('SYNTHETIC code')}],messages:[{role:'user',content:'SYNTHETIC review'}]});
export async function fixtureRun(handler,options={}){const observed=[],sockets=new Set();const server=http.createServer(async(q,r)=>{const chunks=[];for await(const c of q)chunks.push(c);const responseChunks=[];const write=r.write.bind(r),end=r.end.bind(r);r.write=(chunk,...args)=>{if(chunk)responseChunks.push(Buffer.from(chunk));return write(chunk,...args);};r.end=(chunk,...args)=>{if(chunk)responseChunks.push(Buffer.from(chunk));return end(chunk,...args);};const responseRecord={bytes_base64:null};r.on('close',()=>{responseRecord.bytes_base64=Buffer.concat(responseChunks).toString('base64');responseRecord.status=r.statusCode;});observed.push({request_bytes_base64:Buffer.concat(chunks).toString('base64'),response:responseRecord,auth_matches:q.headers.authorization===`Bearer ${options.fixtureCredential??key}`,body:JSON.parse(Buffer.concat(chunks))});handler(q,r,observed.length,observed.at(-1));});server.on('connection',s=>{sockets.add(s);s.on('close',()=>sockets.delete(s));});await new Promise(r=>server.listen(0,'127.0.0.1',r));try{const result=await runControlledFixture({endpoint:`http://127.0.0.1:${server.address().port}/fixture`,fixtureCredential:key,packet:packet(),...options});return {result,observed};}finally{for(const s of sockets)s.destroy();await new Promise(r=>server.close(r));}}
