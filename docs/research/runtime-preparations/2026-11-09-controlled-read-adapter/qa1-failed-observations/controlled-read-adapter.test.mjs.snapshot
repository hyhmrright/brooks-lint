import test from 'node:test';
import assert from 'node:assert/strict';
import {fixtureRun} from './controlled-read-fixture.mjs';
import {createHash} from 'node:crypto';
import {createReadCapability,createRunLedger,runControlledFixture} from './controlled-read-adapter.mjs';
const hash=s=>createHash('sha256').update(s).digest('hex');
const key='fixture-only-'+'1'.repeat(32);
const packet=()=>({files:[{path:'case/code.js',content:'SYNTHETIC code',sha256:hash('SYNTHETIC code')}],messages:[{role:'user',content:'SYNTHETIC review'}]});
const answer={model:'fixture-cheap',reasoning:'low',type:'answer',text:'SYNTHETIC answer'};
const tool={model:'fixture-cheap',reasoning:'low',type:'tool',call:{name:'read_file',path:'case/code.js'}};

const send=(r,v)=>{r.writeHead(200,{'content-type':'application/json'});r.end(JSON.stringify(v));};

test('parent transport completes authored read continuation without putting credential in tool/model payload',async()=>{const {result,observed}=await fixtureRun((_q,r,n)=>send(r,n===1?tool:answer));assert.equal(result.status,'fixture-completed');assert.equal(result.reads.length,1);assert.equal(observed.length,2);assert(observed.every(o=>o.auth_matches));assert.equal(observed[1].body.tool_result.content,'SYNTHETIC code');assert(!JSON.stringify(observed).includes(key));assert(!JSON.stringify(result).includes(key));assert.equal(result.actual_responding_model,null);assert.equal(result.live_ready,false);assert.equal(result.study_eligible,false);});
test('read capability is immutable and exact-path only; OS paths and non-read tools fail',()=>{const p=packet(),read=createReadCapability(p);p.files[0].content='mutated';assert.equal(read(tool.call).content,'SYNTHETIC code');for(const call of [{name:'shell',path:'case/code.js'},{name:'read_file',path:'../auth.json'},{name:'read_file',path:'/etc/passwd'},{name:'read_file',path:'case/./code.js'},{name:'read_file',path:'case/code.js',command:'curl'}])assert.throws(()=>read(call));assert.throws(()=>createReadCapability({files:[...packet().files,...packet().files]}));assert.throws(()=>createReadCapability({files:[{...packet().files[0],sha256:'wrong'}]}));});
test('ledger freezes caller config and rejects mid-run model/reasoning changes',()=>{const c={model:'fixture-cheap',reasoning:'low',max_requests:2,budget_microunits:2,reservation_microunits:1},l=createRunLedger(c);c.model='expensive';l.reserve('fixture-cheap','low');assert.throws(()=>l.reserve('expensive','low'));assert.throws(()=>l.reserve('fixture-cheap','high'));assert.equal(l.snapshot().requests,1);l.stop('identity-mismatch');assert.throws(()=>l.reserve('fixture-cheap','low'));assert.equal(l.snapshot().actual_cost,null);});
for(const [name,value,reason] of [['unknown tool',{...tool,call:{name:'shell',path:'case/code.js'}},'tool-or-envelope-denied'],['traversal',{...tool,call:{name:'read_file',path:'../../auth.json'}},'tool-or-envelope-denied'],['model mismatch',{...answer,model:'expensive'},'identity-mismatch'],['effort mismatch',{...answer,reasoning:'high'},'identity-mismatch'],['missing identity',{type:'answer',text:'I am fixture-cheap'},'identity-unreported'],['auth echo',{...answer,text:key},'credential-echo'],['extra fields',{...answer,usage:{tokens:0}},'tool-or-envelope-denied']])test(name+' stops without continuation',async()=>{const {result,observed}=await fixtureRun((_q,r)=>send(r,value));assert.equal(result.reason,reason);assert.equal(observed.length,1);assert.equal(result.answer,null);});
for(const status of [301,307,401,403,429,503])test('HTTP '+status+' has no redirect, credential refresh or retry',async()=>{const {result,observed}=await fixtureRun((_q,r)=>{r.writeHead(status,{'location':'http://127.0.0.1:1/fixture','retry-after':'0'});r.end('{}');});assert.equal(result.reason,`http-${status}`);assert.equal(observed.length,1);});
test('request and reservation limits stop looping tools before another dispatch',async()=>{for(const [options,reason] of [[{max_requests:1},'request-cap'],[{budget_microunits:1},'budget-cap']]){const {result,observed}=await fixtureRun((_q,r)=>send(r,tool),options);assert.equal(result.reason,reason);assert.equal(observed.length,1);}});
test('absolute exchange deadline terminates drip response',async()=>{const {result}=await fixtureRun((_q,r)=>{r.writeHead(200);const t=setInterval(()=>r.write(' '),5);r.on('close',()=>clearInterval(t));},{timeout_ms:50});assert.equal(result.reason,'deadline');});
test('response bytes and request bytes are bounded',async()=>{const {result}=await fixtureRun((_q,r)=>{r.writeHead(200);r.end('x'.repeat(2000));},{max_bytes:1000});assert.equal(result.reason,'response-byte-cap');assert.equal(result.exchanges[0].response_bytes,1000);const small=await fixtureRun((_q,r)=>send(r,answer),{max_bytes:1});assert.equal(small.result.reason,'request-byte-cap');assert.equal(small.observed.length,0);});
test('malformed or incomplete responses never become answers',async()=>{for(const text of ['{','null','[]']){const {result}=await fixtureRun((_q,r)=>{r.writeHead(200);r.end(text);});assert.equal(result.status,'failed');assert.equal(result.answer,null);}});
test('only owned exact endpoint and explicit fixture credentials accepted',async()=>{for(const endpoint of ['https://api.openai.com/v1/responses','http://localhost:123/fixture','http://127.0.0.1:123/fixture?x=1'])await assert.rejects(runControlledFixture({endpoint,fixtureCredential:key,packet:packet()}));await assert.rejects(runControlledFixture({endpoint:'http://127.0.0.1:1/fixture',fixtureCredential:'sk-real-looking',packet:packet()}));});
test('fixture credential rotation belongs to new runs; no credential stored by ledger',async()=>{const a=await fixtureRun((_q,r)=>send(r,answer));const b=await fixtureRun((_q,r)=>send(r,answer),{fixtureCredential:'fixture-only-'+'2'.repeat(32)});assert.equal(a.observed[0].auth_matches,true);assert.equal(b.observed[0].auth_matches,true);assert.equal(a.result.ledger.requests,1);assert.equal(b.result.ledger.requests,1);assert(!JSON.stringify(b.result).includes('fixture-only-'));});

test('one monotonic deadline spans both tool exchanges',async()=>{const {result,observed}=await fixtureRun((_q,r,n)=>{const timer=setTimeout(()=>send(r,n===1?tool:answer),80);r.on('close',()=>clearTimeout(timer));},{timeout_ms:120});assert.equal(observed.length,2);assert.equal(result.reason,'deadline');assert(result.elapsed_ms<250);});
test('packet file count, combined bytes and evaluation-only paths are refused',()=>{assert.throws(()=>createReadCapability({files:Array.from({length:65},(_,i)=>({path:`p${i}`,content:'',sha256:hash('')}))}));assert.throws(()=>createReadCapability({files:[{path:'rubric.json',content:'',sha256:hash('')}]}));const content='x'.repeat(150000);assert.throws(()=>createReadCapability({files:[0,1].map(i=>({path:`p${i}`,content,sha256:hash(content)}))}));});

test('saved exploratory evidence validates without live model calls',async()=>{const {validate}=await import('./controlled-read-drill.mjs');const result=validate((await import('node:url')).fileURLToPath(new URL('../../../../docs/research/runtime-preparations/2026-11-09-controlled-read-adapter/observations/',import.meta.url)));assert.equal(result.model_calls,0);});
