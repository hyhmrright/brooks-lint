{
  "name": "brooks-lint",
  "version": "1.9.1",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "bin",
    "scripts/install.sh",
    "scripts/npm-platforms.mjs"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "bump": "node scripts/bump-version.mjs",
    "validate": "node scripts/validate-repo.mjs",
    "test": "node scripts/validate-repo.test.mjs && node --test scripts/dsh-provider.test.mjs && node --test scripts/npm-install.test.mjs scripts/dsh-market.test.mjs scripts/check-release-ci.test.mjs scripts/github-metadata.test.mjs scripts/report-contract.test.mjs scripts/runner-contract.test.mjs scripts/codex-evals.test.mjs evals/research/runtime/runtime.test.mjs scripts/runtime-research.test.mjs evals/research/runtime/calibration/scoring.test.mjs evals/research/runtime/candidate-holdouts/candidates.test.mjs evals/research/runtime/prospective/study.test.mjs evals/research/runtime/prospective/drill.test.mjs evals/research/runtime/prospective/reviews.test.mjs evals/research/runtime/prospective/human-preparation.test.mjs evals/research/runtime/prospective/executor-preparation.test.mjs evals/research/runtime/prospective/process-executor.test.mjs evals/research/runtime/prospective/model-channel.test.mjs evals/research/runtime/prospective/codex-channel.test.mjs",
    "evals": "node scripts/run-evals.mjs",
    "evals:runtime:offline": "node --test evals/research/runtime/runtime.test.mjs scripts/runtime-research.test.mjs",
    "evals:runtime:research": "node scripts/run-runtime-research.mjs",
    "evals:runtime:research:validate": "node scripts/run-runtime-research.mjs --validate",
    "evals:live": "node scripts/run-evals-live.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "history": "node scripts/history.mjs",
    "changelog:audit": "node scripts/changelog-audit.mjs",
    "market:generate": "node scripts/gen-dsh-market.mjs",
    "release:ci": "node scripts/check-release-ci.mjs",
    "prepublishOnly": "npm run release:ci",
    "github:metadata": "node scripts/github-metadata.mjs",
    "evals:codex": "node scripts/run-codex-evals.mjs",
    "evals:codex:validate": "node scripts/run-codex-evals.mjs --validate",
    "evals:runtime:prepared": "node evals/research/runtime/calibration/validate.mjs && node evals/research/runtime/candidate-holdouts/validate.mjs && node --test evals/research/runtime/calibration/scoring.test.mjs evals/research/runtime/candidate-holdouts/candidates.test.mjs evals/research/runtime/prospective/study.test.mjs evals/research/runtime/prospective/drill.test.mjs evals/research/runtime/prospective/reviews.test.mjs evals/research/runtime/prospective/human-preparation.test.mjs evals/research/runtime/prospective/executor-preparation.test.mjs evals/research/runtime/prospective/process-executor.test.mjs evals/research/runtime/prospective/model-channel.test.mjs evals/research/runtime/prospective/codex-channel.test.mjs",
    "evals:runtime:prospective": "node evals/research/runtime/prospective/cli.mjs",
    "evals:runtime:drill": "node evals/research/runtime/prospective/drill.mjs validate",
    "evals:runtime:reviews": "node evals/research/runtime/prospective/reviews-cli.mjs",
    "evals:runtime:reviews:validate": "node evals/research/runtime/prospective/reviews-drill.mjs validate",
    "evals:runtime:executor:validate": "node evals/research/runtime/prospective/executor-preparation-drill.mjs validate",
    "evals:runtime:process:validate": "node evals/research/runtime/prospective/process-executor-drill.mjs validate",
    "evals:runtime:channel:validate": "node evals/research/runtime/prospective/model-channel-drill.mjs validate",
    "evals:runtime:cli:validate": "node evals/research/runtime/prospective/codex-channel-drill.mjs validate",
    "evals:runtime:cli:record": "node evals/research/runtime/prospective/codex-channel-drill.mjs record"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.52.0"
  },
  "description": "AI code quality reviews grounded in twelve engineering books, with six portable Agent Skills for coding agents.",
  "author": "hyhmrright",
  "homepage": "https://hyhmrright.github.io/brooks-lint/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyhmrright/brooks-lint.git"
  },
  "bugs": {
    "url": "https://github.com/hyhmrright/brooks-lint/issues"
  },
  "keywords": [
    "agent-skills",
    "code-review",
    "architecture",
    "technical-debt",
    "codex",
    "claude-code",
    "cursor",
    "copilot",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "bin": {
    "brooks-lint": "bin/brooks-lint.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
